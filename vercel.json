{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/*.js": { "includeFiles": "{data.js,mariner-data.js}" }
  },
  "crons": [
    {
      "path": "/api/daily-tracking-emails",
      "schedule": "15 8 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "header", "key": "host", "value": "cavero-three.vercel.app" }
      ],
      "destination": "https://caverowatches.vercel.app/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        { "type": "header", "key": "host", "value": "cavero-zetawebs-projects.vercel.app" }
      ],
      "destination": "https://caverowatches.vercel.app/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/checkout/:path*",
      "headers": [ { "key": "X-Robots-Tag", "value": "noindex, nofollow" } ]
    },
    {
      "source": "/pesquisar",
      "headers": [ { "key": "X-Robots-Tag", "value": "noindex, follow" } ]
    },
    {
      "source": "/404",
      "headers": [ { "key": "X-Robots-Tag", "value": "noindex, follow" } ]
    }
  ]
}
